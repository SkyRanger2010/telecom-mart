POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432
# Порт PostgreSQL внутри docker-сети 
POSTGRES_INTERNAL_PORT=5432
POSTGRES_HOST=postgres

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
# Каталог на хосте для данных MinIO (bind mount). Относительный путь — от deploy/compose/.
MINIO_DATA_PATH=./minio_data
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_HOST=minio

TRINO_PORT=8088
# Порт Trino внутри docker-сети 
TRINO_INTERNAL_PORT=8080
TRINO_HOST=trino
TRINO_USER=airflow
TRINO_CATALOG=iceberg
TRINO_HTTP_SCHEME=http

CLICKHOUSE_DB=serving
CLICKHOUSE_USER=serving_user
CLICKHOUSE_PASSWORD=change_me_clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_HOST=clickhouse

AIRFLOW_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow
AIRFLOW_ADMIN_EMAIL=admin@telecom-mart.local
AIRFLOW_UID=50000
AIRFLOW_PORT=8081

AIRFLOW_SQL_ALCHEMY_CONN=postgresql+psycopg2://platform:change_me_postgres@postgres:5432/airflow
AIRFLOW_API_SQL_ALCHEMY_POOL_SIZE=40
AIRFLOW_API_SQL_ALCHEMY_MAX_OVERFLOW=100
AIRFLOW_API_SQL_ALCHEMY_POOL_TIMEOUT=180
AIRFLOW_API_SQL_ALCHEMY_POOL_RECYCLE=3600
AIRFLOW_API_SECRET_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f


S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_minio
S3_PATH_STYLE_ACCESS=true
S3_SSL_ENABLED=false
S3_REGION=us-east-1
# Iceberg JDBC catalog (метаданные в Postgres, данные в S3/MinIO).
ICEBERG_JDBC_CATALOG_NAME=tm_iceberg
ICEBERG_CATALOG_WAREHOUSE=s3://tm-iceberg/

# Source DB (HALK) for raw loader scripts.
# Можно оставлять host.docker.internal; `make tunnel-sync-runtime-ips` при необходимости
# автоматически обновит HALK_PG_HOST до gateway IP docker-сети.
HALK_PG_HOST=host.docker.internal
HALK_PG_PORT=15432
HALK_PG_DB=halk
HALK_PG_USER=change_me_halk_user
HALK_PG_PASSWORD=change_me_halk_password
HALK_PG_SSLMODE=disable
# Docker gateway IP, который будет подставлен в extra_hosts как host.docker.internal
# и синхронизирован вместе с HALK_PG_HOST командой `make tunnel-sync-runtime-ips`.
HOST_DOCKER_INTERNAL_IP=


# dashbot — Django KPI + drilldown по витринам ClickHouse, чат NL2SQL (вызывает LLM_API/sqlguard).
DASHBOT_STUB_PORT=8090
SQLGUARD_STUB_PORT=8091
LLM_STUB_PORT=8092
CLICKHOUSE_INTERNAL_HTTP_PORT=8123
DASHBOT_URL=http://dashbot:8080
SQLGUARD_API_URL=http://sqlguard-api:8080
LLM_API_URL=http://llm-api:8080
NL2SQL_MAX_ROWS=500
# Модель DeepSeek для NL2SQL (дашборд по запросу и чат в сайдбаре).
# deepseek-chat — обычный чат; deepseek-reasoner — с рассуждением (медленнее).
NL2SQL_LLM_MODEL=deepseek-chat
# llm-api: прокси к DeepSeek (OpenAI-compatible Chat Completions). Пусто — заглушка в контейнере.
LLM_UPSTREAM_CHAT_COMPLETIONS_URL=https://api.deepseek.com/v1/chat/completions
# Ключ DeepSeek (platform.deepseek.com): можно sk-... (llm-api добавит Bearer) или Bearer sk-...
LLM_UPSTREAM_AUTH_TOKEN=
LLM_UPSTREAM_TIMEOUT_SEC=120
# Таблица ClickHouse, которую пересоздаёт sqlguard после ответа модели (дашборд по запросу).
QUERY_DASHBOARD_TABLE=dashboard_query_stub